<!DOCTYPE html>
<html lang="ja" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>大喜利実験室 - プレイヤー実績アーカイブ</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        labDark: '#0a0f1d',
                        labGlass: 'rgba(15, 23, 42, 0.6)',
                        labBorder: 'rgba(255, 255, 255, 0.08)',
                    },
                    fontFamily: {
                        mono: ['Share Tech Mono', 'monospace', 'ui-monospace'],
                        sans: ['Noto Sans JP', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts, Lucide Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght=300;400;500;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* グラスモーフィズムなどのカスタムスタイル */
        .glassmorphism {
            background: rgba(13, 20, 38, 0.45);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glow-effect-orange {
            box-shadow: 0 0 15px rgba(249, 115, 22, 0.2);
        }
        /* スクロールバーのカスタマイズ */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0a0f1d;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #f97316;
        }
    </style>
</head>
<body class="bg-labDark text-slate-100 font-sans selection:bg-orange-500 selection:text-black min-h-screen relative overflow-x-hidden" style="--theme-color: #f97316; --glow-color: rgba(249, 115, 22, 0.3);">

    <!-- 背景Canvas（分子＆気泡アニメーション：実績ページはオレンジネオン粒子） -->
    <canvas id="labBackground" class="fixed top-0 left-0 w-full h-full -z-10 pointer-events-none opacity-30"></canvas>

    <!-- ヘッダーナビゲーション -->
    <header class="sticky top-0 z-50 glassmorphism border-b border-labBorder transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- ロゴ (指定のメインURLに紐付け) -->
            <a href="https://ogirimad.github.io/ogiri_madlab/#" class="flex items-center space-x-3 group">
                <!-- フラスコは緑で、フラスコの中の液体をオレンジに設定 -->
                <div class="relative w-10 h-10 flex items-center justify-center rounded-lg bg-slate-900 border border-slate-700 overflow-hidden group-hover:border-orange-400 transition-colors duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 group-hover:animate-bounce">
                        <path d="M10 2v7.586l-4.707 4.707A2 2 0 0 0 5 15.707V19a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3.293a2 2 0 0 0-.586-1.414L14 9.586V2z" stroke="#10b981" />
                        <path d="M10 2h4" stroke="#10b981" />
                        <path d="M7.5 15.5h9l1.8 3.5a1 1 0 0 1-.9 1.5H6.6a1 1 0 0 1-.9-1.5z" fill="#f97316" stroke="#f97316" stroke-width="1" />
                    </svg>
                </div>
                <div>
                    <span class="font-mono text-xl font-bold tracking-wider text-white">大喜利実験室</span>
                    <span class="block text-xs text-orange-400 tracking-widest font-mono">OGIRI LABORATORY</span>
                </div>
            </a>

            <!-- ナビゲーションリンク (指定のメインURLに紐付け) -->
            <nav class="flex items-center space-x-6">
                <a href="https://ogirimad.github.io/ogiri_madlab/#" class="text-xs sm:text-sm font-medium hover:text-orange-400 transition-colors flex items-center gap-1.5">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i> メインサイトへ戻る
                </a>
            </nav>
        </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        
        <!-- セクションイントロ -->
        <div class="text-center max-w-3xl mx-auto mb-16 relative z-10">
            <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-slate-900/80 border border-orange-500/30 text-orange-400 text-xs font-mono tracking-widest mb-6 glow-effect-orange">
                <span class="w-1.5 h-1.5 rounded-full bg-orange-400 animate-ping"></span>
                <span>SUBJECT DATA RECORD [VER 1.2]</span>
            </div>
            <!-- 「実績記録」に変更 -->
            <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4">
                <span class="bg-clip-text text-transparent bg-gradient-to-r from-orange-400 via-amber-200 to-yellow-400">
                    実績記録
                </span>
            </h1>
            <!-- ご指定の改行位置に修正 -->
            <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
                大喜利実験室の企画で過去に記録された<br>優秀なプレイヤーの実績データです。
            </p>
        </div>

        <!-- 検索バー -->
        <div class="flex items-center justify-between gap-4 mb-8 max-w-xl mx-auto relative z-10">
            <div class="relative w-full">
                <i data-lucide="search" class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-slate-500"></i>
                <input id="search-input" type="text" placeholder="プレイヤー名や実績で検索..." class="w-full pl-10 pr-4 py-3 bg-slate-950 border border-slate-800 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-orange-500 transition-colors">
            </div>
        </div>

        <!-- プレイヤーカード一覧グリッド -->
        <div id="achievementsGrid" class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto relative z-10">
            <!-- JSで動的にカードが差し込まれます -->
        </div>

        <!-- プレイヤーがいない場合、または検索結果がない場合の表示 -->
        <div id="no-results" class="hidden text-center py-20 relative z-10">
            <i data-lucide="database-backup" class="w-12 h-12 text-slate-600 mx-auto mb-4"></i>
            <p class="text-slate-400 text-sm">該当する実験データが見つかりませんでした。</p>
        </div>

        <!-- 下部アクション (指定のメインURLに紐付け) -->
        <div class="mt-20 text-center relative z-10">
            <a href="https://ogirimad.github.io/ogiri_madlab/#" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl glassmorphism border border-slate-800 hover:border-orange-500 hover:text-orange-400 text-sm font-semibold transition-all duration-300 transform hover:-translate-y-1">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> メインの実験室へ戻る
            </a>
        </div>

    </main>

    <!-- フッター -->
    <footer class="bg-slate-950 border-t border-labBorder py-12 relative z-10 mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
            <div>
                <p class="font-mono text-sm text-slate-400">&copy; 2026 大喜利実験室 (OGIRI LABORATORY). ALL RIGHTS RESERVED.</p>
            </div>
            <!-- SNSリンク -->
            <div class="flex space-x-6 text-slate-500">
                <a href="#" class="hover:text-orange-400 transition-colors"><i data-lucide="github" class="w-5 h-5"></i></a>
                <a href="https://x.com/ogiri_mad?s=11" target="_blank" class="hover:text-orange-400 transition-colors"><i data-lucide="twitter" class="w-5 h-5"></i></a>
                <a href="#" class="hover:text-orange-400 transition-colors"><i data-lucide="instagram" class="w-5 h-5"></i></a>
                <a href="#" class="hover:text-orange-400 transition-colors"><i data-lucide="youtube" class="w-5 h-5"></i></a>
            </div>
        </div>
    </footer>

    <!-- 実績データ管理＆動的描画スクリプト -->
    <script>
        // Lucideアイコンの初期化
        lucide.createIcons();

        // プレイヤー＆実績 データベース (SUBからNoに変更)
        const playerRecords = [
            {
                subjectId: "No-101",
                name: "Dシンカー",
                achievements: [
                    {
                        title: "プラス・マイナスvol.1",
                        rank: "第2位",
                        badgeColor: "from-orange-500/20 to-amber-500/20 text-orange-400 border-orange-500/30"
                    }
                ]
            },
            {
                subjectId: "No-102",
                name: "ねこねずみ",
                achievements: [
                    {
                        title: "プラス・マイナスvol.1",
                        rank: "第3位",
                        badgeColor: "from-cyan-500/20 to-teal-500/20 text-cyan-400 border-cyan-500/30"
                    }
                ]
            }
        ];

        // 描画処理
        const grid = document.getElementById('achievementsGrid');
        const searchInput = document.getElementById('search-input');
        const noResults = document.getElementById('no-results');

        function renderCards() {
            const query = searchInput.value.trim().toLowerCase();
            
            // 検索フィルタリング
            const filtered = playerRecords.filter(player => {
                const matchesName = player.name.toLowerCase().includes(query);
                const matchesAchievement = player.achievements.some(ach => 
                    ach.title.toLowerCase().includes(query) || ach.rank.toLowerCase().includes(query)
                );
                return matchesName || matchesAchievement;
            });

            grid.innerHTML = '';

            if (filtered.length === 0) {
                noResults.classList.remove('hidden');
                grid.classList.add('hidden');
                return;
            } else {
                noResults.classList.add('hidden');
                grid.classList.remove('hidden');
            }

            filtered.forEach(player => {
                const card = document.createElement('div');
                card.className = "glassmorphism rounded-3xl p-6 md:p-8 border border-labBorder relative overflow-hidden group hover:border-orange-500/30 transition-all duration-500 shadow-xl";
                
                // 実績バッジのHTML生成
                let achievementsHtml = '';
                player.achievements.forEach(ach => {
                    achievementsHtml += `
                        <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-gradient-to-r ${ach.badgeColor} border text-xs font-bold font-mono tracking-wider shadow-inner group-hover:scale-[1.02] transition-transform">
                            <i data-lucide="medal" class="w-4 h-4 flex-shrink-0 animate-pulse"></i>
                            <div>
                                <span class="block text-[10px] opacity-70 uppercase tracking-widest font-mono">CONQUERED REPORT</span>
                                <span class="text-sm">${ach.title} / <span class="font-extrabold text-white">${ach.rank}</span></span>
                            </div>
                        </div>
                    `;
                });

                // ACTIVEバッジおよびTACTICAL PROFILEは削除したスマートな構成
                card.innerHTML = `
                    <div class="absolute inset-0 opacity-[0.03] bg-[linear-gradient(to_bottom,transparent_50%,#f97316_50%)] [background-size:100%_4px] pointer-events-none"></div>
                    
                    <div class="flex items-start justify-between mb-6">
                        <div>
                            <span class="font-mono text-[10px] text-orange-500 tracking-widest block mb-1">${player.subjectId}</span>
                            <h3 class="text-xl sm:text-2xl font-bold text-white tracking-wide group-hover:text-orange-400 transition-colors duration-300">${player.name}</h3>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="space-y-2">
                            <span class="block text-[10px] font-mono text-slate-500 uppercase tracking-widest">RECORDED ACHIEVEMENTS</span>
                            ${achievementsHtml}
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });

            lucide.createIcons();
        }

        searchInput.addEventListener('input', renderCards);
        renderCards();
    </script>

    <!-- 背景ネオンオレンジ粒子アニメーション -->
    <script>
        const canvas = document.getElementById('labBackground');
        const ctx = canvas.getContext('2d');
        let particles = [];
        let themeColor = '#f97316';

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class Particle {
            constructor() { this.reset(); }
            reset() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height + canvas.height;
                this.size = Math.random() * 4 + 1;
                this.speedY = -(Math.random() * 0.6 + 0.15);
                this.speedX = Math.random() * 0.4 - 0.2;
                this.opacity = Math.random() * 0.4 + 0.05;
            }
            update() {
                this.y += this.speedY;
                this.x += this.speedX;
                if (this.y < 0 || this.opacity <= 0) { this.reset(); }
            }
            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = themeColor;
                ctx.globalAlpha = this.opacity;
                ctx.fill();
            }
        }

        for (let i = 0; i < 30; i++) {
            particles.push(new Particle());
            particles[i].y = Math.random() * canvas.height;
        }

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => { p.update(); p.draw(); });

            ctx.strokeStyle = themeColor;
            for (let i = 0; i < particles.length; i++) {
                for (let j = i + 1; j < particles.length; j++) {
                    const dx = particles[i].x - particles[j].x;
                    const dy = particles[i].y - particles[j].y;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    if (dist < 120) {
                        ctx.beginPath();
                        ctx.moveTo(particles[i].x, particles[i].y);
                        ctx.lineTo(particles[j].x, particles[j].y);
                        ctx.globalAlpha = (120 - dist) / 120 * 0.1;
                        ctx.lineWidth = 0.5;
                        ctx.stroke();
                    }
                }
            }
            requestAnimationFrame(animateParticles);
        }
        animateParticles();
    </script>
</body>
</html>
